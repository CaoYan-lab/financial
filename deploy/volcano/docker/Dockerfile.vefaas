# 火山 veFaaS 单镜像双角色（Web 函数 / 常驻 Worker）。
# 由 APP_ROLE=web|worker 选择入口（见 deploy/volcano/faas/run-*.sh）。
# 监听 0.0.0.0:8000（veFaaS Webserver 模式要求）。
# 构建上下文为仓库根目录：docker build -f deploy/volcano/docker/Dockerfile.vefaas -t <image> .

# ---------- Stage 1: 前端构建 ----------
FROM node:20-trixie-slim AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com \
  && npm ci
COPY . .
# 容器内仅做 vite 打包（esbuild 转译，跳过开发期 tsc 严格类型门），保证静态资源产出；
# 类型检查在本地开发/CI 用 `npm run build` 执行。
RUN VITE_AUTH_ENABLED=true npx vite build

# ---------- Stage 2: 运行时（Node + Python 同镜像） ----------
FROM node:20-trixie-slim AS runtime

# Python 3.11 + pip，使用火山镜像源加速
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's|deb.debian.org|mirrors.ivolces.com|g; s|security.debian.org|mirrors.ivolces.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
  && apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv python3-pip git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Node 依赖（仅生产依赖 + tsx 用于运行 TS）
# 注意：longbridge 含按平台分发的原生 .node（optionalDependencies）。npmmirror 上的
# longbridge-linux-* 是无关旧包（0.2.x），缺 4.x；故主依赖走 npmmirror 加速后，
# 再从官方 registry 重装 longbridge，让其按 linux 平台正确拉取 longbridge-linux-x64-gnu@4.3.2。
COPY package.json package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com \
  && npm install --omit=dev \
  && npm install -g tsx \
  && npm install --no-save --registry=https://registry.npmjs.org longbridge@4.3.2

# Python 依赖（PG 驱动 + 数据处理）用火山 pypi 镜像；
# futu-api 必须为 10.x（OpenSecTradeContext/OpenQuoteContext 支持 ai_type 参数，
# 火山 pypi 镜像最新仅 9.4.5408 缺该参数会导致连接 OpenD 报错），故 futu-api 走清华源锁版本。
RUN python3 -m venv /opt/venv \
  && /opt/venv/bin/pip install --no-cache-dir \
      -i https://mirrors.ivolces.com/pypi/simple/ \
      "psycopg[binary]" "pandas" "numpy" \
  && /opt/venv/bin/pip install --no-cache-dir --upgrade \
      -i https://pypi.tuna.tsinghua.edu.cn/simple/ \
      "futu-api==10.10.7008"

# 应用代码
COPY . .
# 前端构建产物（dist）
COPY --from=frontend /app/dist ./dist

# TradingAgents（A股多智能体）构建期拉取并装到独立 venv；
# 失败不阻断镜像构建（A股 worker 启动时会报缺失，其余平台不受影响）。
ARG SKIP_TRADINGAGENTS=
RUN if [ -z "$SKIP_TRADINGAGENTS" ]; then \
      bash deploy/volcano/scripts/fetch-tradingagents.sh || echo "WARN: TradingAgents fetch skipped/failed"; \
    fi

# 启动脚本可执行
RUN chmod +x deploy/volcano/faas/run-web.sh deploy/volcano/faas/run-worker.sh

ENV NODE_ENV=production \
    PORT=8000 \
    FUTU_PYTHON_BIN=/opt/venv/bin/python \
    VOLCANO_CLOUD_PYTHONPATH=/app/deploy/volcano/pg/python \
    PYTHONPATH=/app/deploy/volcano/pg/python \
    TRADINGAGENTS_PYTHON_BIN=/app/.venv-tradingagents/bin/python \
    TRADINGAGENTS_REPO_PATH=/app/third_party/TradingAgents

EXPOSE 8000

# 默认入口；veFaaS 启动命令可覆盖为 run-web.sh 或 run-worker.sh
CMD ["bash", "deploy/volcano/faas/run-web.sh"]
