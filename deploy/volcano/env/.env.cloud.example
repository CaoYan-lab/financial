# ============ 火山云端运行环境变量模板 ============
# 本文件只列配置项，不含任何密钥值；真实值通过 veFaaS 环境变量/Secret 注入。

# ---- 运行形态 ----
CLOUD_MODE=1
APP_ROLE=web                     # web=Web 函数；worker=常驻交易引擎函数
PORT=8000                        # veFaaS Web 函数监听端口（worker 健康端口同用）

# ---- 数据库（AIDAP PostgreSQL 版连接串） ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/financial
PG_POOL_MAX=5

# ---- 登录鉴权 ----
AUTH_ENABLED=true
AUTH_JWT_SECRET=                 # 至少 16 字符随机串
ADMIN_USERNAME=                  # 仅首次启动播种管理员，之后忽略
ADMIN_PASSWORD=                  # 仅首次启动播种，登录后可另行改密
CLOUD_COOKIE_SECURE=true         # HTTPS 域名下设为 true

# ---- Python Bridge / PG 历史驱动 ----
PG_HISTORY_DRIVER=1              # 历史脚本经垫片走 PG（SQLite 为缺省，不设即本地旧行为）
FUTU_PYTHON_BIN=python3          # 容器内 python（含 futu-api、psycopg）
VOLCANO_CLOUD_PYTHONPATH=/app/deploy/volcano/pg/python

# ---- Futu OpenD（仅 worker，指向 Windows ECS 内网地址） ----
FUTU_OPEND_HOST=10.0.x.x
FUTU_OPEND_PORT=11111

# ---- TradingAgents（A 股 LLM 多智能体链路，仅 worker 需要） ----
# third_party/ 与 .venv* 不随仓库分发，镜像构建期或首启执行：
#   bash deploy/volcano/scripts/fetch-tradingagents.sh
# 该脚本按 deploy/volcano/tradingagents/VERSION 锁定的 commit 拉取并建独立 venv。
TRADINGAGENTS_REPO_PATH=/app/third_party/TradingAgents
TRADINGAGENTS_PYTHON_BIN=/app/.venv-tradingagents/bin/python

# ---- LLM / 券商密钥（沿用本地变量名，由 Secret 注入） ----
# ARK_API_KEY / ARK_RESPONSES_URL / ARK_MODEL
# LONGBRIDGE_APP_KEY / LONGBRIDGE_APP_SECRET / LONGBRIDGE_ACCESS_TOKEN
# LIVE_TRADING_ENABLED / FUTU_LIVE_TRD_ENV 等交易门禁保持既有变量名
# A 股 TradingAgents 相关：TRADINGAGENTS_LLM_PRESET_*（与本地 .env.local 同名）
