{
  "name": "trae-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run --pool=threads --maxWorkers=4",
    "test:unit": "vitest run --config vitest.config.ts --coverage",
    "test:integration:db": "./scripts/run-pg-integration.sh",
    "test:integration:http": "./scripts/run-pg-integration.sh tests/cloud/*Api*.integration.test.ts tests/multiuser/*Http*.integration.test.ts",
    "test:smoke:external": "./scripts/test-external-readonly.sh",
    "test:e2e": "playwright test",
    "test:release:local": "./scripts/run-local-release-tests.sh",
    "longbridge:sdk-cache:concurrency": "tsx scripts/longbridge-sdk-cache-concurrency.ts",
    "server:dev": "nodemon",
    "server:cloud": "tsx api/cloud/cloudServer.ts",
    "server:worker": "tsx api/cloud/worker/workerServer.ts",
    "local:multiuser": "./scripts/run-multiuser-local.sh",
    "dev:error-logs": "bash scripts/start-dev-error-logs.sh",
    "dev": "concurrently \"npm run client:dev\" \"npm run server:dev\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "longbridge": "^4.3.2",
    "lucide-react": "^0.511.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "yaml": "^2.9.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^5.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
