{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changfu.local/schemas/model-run-event.schema.json",
  "title": "ModelRunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "requestId", "occurredAt"],
  "properties": {
    "type": { "enum": ["accepted", "progress", "result", "error"] },
    "requestId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "stage": { "type": "string", "minLength": 1, "maxLength": 64 },
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "result": { "$ref": "model-result.schema.json" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 100 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "result" } } },
      "then": { "required": ["result"] }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": { "required": ["error"] }
    }
  ]
}
