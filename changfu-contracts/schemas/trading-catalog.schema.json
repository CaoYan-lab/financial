{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changfu.local/schemas/trading-catalog.schema.json",
  "title": "TradingCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "publishedAt", "models", "strategies", "prompts", "riskPolicies"],
  "properties": {
    "catalogVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    },
    "strategies": {
      "type": "array",
      "items": { "$ref": "#/$defs/strategy" }
    },
    "prompts": {
      "type": "array",
      "items": { "$ref": "#/$defs/prompt" }
    },
    "riskPolicies": {
      "type": "array",
      "items": { "$ref": "#/$defs/riskPolicy" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "roles", "capabilities", "latencyTier", "plans"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["SINGLE_DECISION", "PORTFOLIO_REVIEW", "MANAGED_ORDER_REVIEW"] }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["STRUCTURED_OUTPUT", "TOOL_CALLING", "REASONING"] }
        },
        "latencyTier": { "enum": ["FAST", "BALANCED", "DEEP"] },
        "plans": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 32 } }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "providers", "markets", "instrumentTypes"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "providers": { "type": "array", "uniqueItems": true, "items": { "enum": ["FUTU", "LONGBRIDGE"] } },
        "markets": { "type": "array", "uniqueItems": true, "items": { "enum": ["US", "HK"] } },
        "instrumentTypes": { "type": "array", "uniqueItems": true, "items": { "enum": ["STOCK", "ETF"] } }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "role", "summary", "constraints", "outputFields", "publishedAt", "contentHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "role": { "enum": ["SINGLE_DECISION", "PORTFOLIO_REVIEW", "MANAGED_ORDER_REVIEW"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "outputFields": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "publishedAt": { "type": "string", "format": "date-time" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "riskPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
