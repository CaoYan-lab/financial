<Window x:Class="ChangFu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="长富"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Background="{StaticResource WorkspaceBackground}">
    <Border Margin="8"
            CornerRadius="24"
            Background="{StaticResource PanelBackground}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="22"
                           FontWeight="Bold"
                           Text="长富" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <RadioButton Margin="0,0,18,0" Content="A 股 · 规划中" IsEnabled="False" />
                    <RadioButton Margin="0,0,18,0" Content="Futu" IsChecked="True" />
                    <RadioButton Content="Longbridge · 规划中" IsEnabled="False" />
                </StackPanel>
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Futu SDK 未配置 · 交易租约未持有" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <ListBox BorderThickness="0" Padding="8" SelectedIndex="0">
                    <ListBoxItem Content="今日总览" />
                    <ListBoxItem Content="市场" />
                    <ListBoxItem Content="研究" />
                    <ListBoxItem Content="交易" />
                    <ListBoxItem Content="资产" />
                    <ListBoxItem Content="历史" />
                </ListBox>

                <Grid Grid.Column="1"
                      Background="{StaticResource WorkspaceBackground}">
                    <StackPanel Margin="20">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="今日总览" />
                        <TextBlock Margin="0,6,0,20"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="连接本机 OpenD 后显示真实账户和行情，不使用示例数据。" />
                        <Border Padding="16"
                                CornerRadius="16"
                                Background="{StaticResource PanelBackground}">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="账户数据不可用" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="14"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="模型对话" />
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="首次发送后才会创建并保存会话" />
                    <DockPanel Grid.Row="2" Margin="12">
                        <Button DockPanel.Dock="Right"
                                Width="40"
                                Height="40"
                                Margin="8,0,0,0"
                                Content="↑"
                                ToolTip="发送" />
                        <TextBox MinHeight="40"
                                 Padding="10"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
